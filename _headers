# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# The CSP only allows this site's own styles, fonts and images: no scripts,
# no frames, no third-party requests, even if something gets injected later.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Fonts and images are cached for a year and never revalidated.
# To ship a changed one, give it a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=31536000, immutable

# Keep the *.pages.dev copy of the site out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
